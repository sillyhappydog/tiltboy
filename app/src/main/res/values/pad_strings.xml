    <string name="pad_check_step3">3/6 Press A, B, X, Y in that order</string>
    <string name="pad_check_step4">4/6 Click the left stick (L3). If nothing arrives, tap \"Not arriving (next)\"</string>
    <string name="pad_check_step5">5/6 Click the right stick (R3). If nothing arrives, tap \"Not arriving (next)\"</string>
    <string name="pad_check_step6">6/6 Tap the text field above to bring up the keyboard and type \"%1$s\" with the controller (left stick ↑, flick the right stick ← and back)</string>
